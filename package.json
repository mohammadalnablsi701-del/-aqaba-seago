{
  "name": "aqaba-seago-api",
  "version": "0.3.1",
  "private": true,
  "description": "Backend API for Aqaba SeaGo marine trips and yacht booking platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "npm run test:safety && npm run test:unit && npm run test:db",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "test:unit": "node scripts/test-safety/run.mjs unit",
    "test:db": "node scripts/test-safety/run.mjs db",
    "test:safety": "node scripts/test-safety/run.mjs safety"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": "20.20.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0"
  }
}
