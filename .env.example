PORT=4000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/aqaba-seago
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BOOKING_HOLD_MINUTES=10

PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret


# Keep false during development / mock-payment testing.
# Set true only after demo data is disabled and a real payment provider is configured.
PUBLIC_LAUNCH=false
SEED_DEMO_DATA=false
ENABLE_MOCK_CHECKOUT=false

# API protection
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=25
