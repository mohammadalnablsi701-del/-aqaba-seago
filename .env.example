PORT=4000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/aqaba-seago
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
BOOKING_HOLD_MINUTES=10

PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-24-characters


# Keep false during development / mock-payment testing.
# Set true only after demo data is disabled and a real payment provider is configured.
PUBLIC_LAUNCH=false
SEED_DEMO_DATA=false
# One-shot guarded cleanup. Leave false except during an intentional cleanup deploy.
CLEANUP_DEMO_ON_START=false
ENABLE_MOCK_CHECKOUT=false

# API protection
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=25


# Pilot deployment notes
# PUBLIC_BASE_URL should be your deployed API URL.
# ALLOWED_ORIGINS can contain comma-separated customer/provider/admin origins.
# Keep PUBLIC_LAUNCH=false while PAYMENT_PROVIDER=mock.
# ENABLE_MOCK_CHECKOUT=true is only for a controlled pilot/test checkout.
